<%= render FlatPack::Sidebar::Component.new(side: sidebar_side) do |sidebar| %>
  <% sidebar.header do %>
    <%= render FlatPack::Sidebar::Header::Component.new(
      brand_abbr: "RS",
      title: "Navigation demo",
      subtitle: current_workspace&.name || "Recording Studio"
    ) %>
  <% end %>

  <% sidebar.items do %>
    <nav class="py-4 space-y-6" aria-label="Main navigation">
      <div class="space-y-1">
        <p class="px-3 text-xs font-semibold uppercase tracking-wide text-[var(--surface-muted-content-color)]">
          Workspaces
        </p>

        <% available_workspaces.each do |workspace_entry| %>
          <% workspace = workspace_entry.fetch(:workspace) %>
          <% role = workspace_entry.fetch(:role).to_s.humanize %>
          <%= render FlatPack::Sidebar::Item::Component.new(
            label: "#{workspace.name} (#{role})",
            href: workspace_path(workspace),
            icon: :folder
          ) %>
        <% end %>
      </div>

        <% if current_root_recording.present? %>
          <% navigation_context.sections.each do |section| %>
            <div class="space-y-1">
              <p class="px-3 text-xs font-semibold uppercase tracking-wide text-[var(--surface-muted-content-color)]">
                <%= section.label %>
              </p>

              <% section.groups.each do |group| %>
                <div class="space-y-1">
                  <p class="px-3 text-[11px] font-medium uppercase tracking-wide text-[var(--surface-muted-content-color)]/80">
                    <%= group.label %>
                  </p>

                  <% group.items.each do |item| %>
                    <%= render FlatPack::Sidebar::Item::Component.new(
                      label: item.label,
                      href: item.href,
                      icon: item.icon
                    ) %>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% end %>
        <% end %>
    </nav>
  <% end %>

  <% sidebar.footer do %>
    <%= render FlatPack::Sidebar::Footer::Component.new(class: "text-sm text-[var(--surface-muted-content-color)]") do %>
      <%= render FlatPack::Sidebar::Item::Component.new(
        label: "Sign out",
        href: destroy_user_session_path,
        icon: :lock,
        class: "mx-0",
        data: { turbo_method: :delete }
      ) %>
    <% end %>
  <% end %>
<% end %>
